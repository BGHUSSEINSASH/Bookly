# ===== Database =====
POSTGRES_PORT=5433
DATABASE_URL="postgresql://bookly:bookly_secret@localhost:5433/bookly?schema=public"

# ===== App =====
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
WEB_ORIGIN=http://localhost:3000

# ===== Auth =====
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ===== Storage (S3 compatible: AWS / MinIO / R2) =====
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bookly-media
S3_ACCESS_KEY=bookly
S3_SECRET_KEY=bookly_secret
S3_FORCE_PATH_STYLE=true

# ===== Cache / Queue =====
REDIS_URL=redis://localhost:6379

# ===== Payments (Gateway) =====
PAYMENT_GATEWAY=sandbox
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
ZAIN_CASH_MERCHANT_ID=
ASIA_HAWALA_MERCHANT_ID=
FASTPAY_MERCHANT_ID=

# ===== Commission (%) =====
COMMISSION_FARM=12
COMMISSION_HOTEL=10
COMMISSION_CAR=10
COMMISSION_FLIGHT=3
COMMISSION_TRIP=12

# ===== Loyalty =====
POINTS_PER_CURRENCY_UNIT=1
POINT_VALUE_MINOR=100
POINTS_REDEEM_RATIO=100

# ===== Maps =====
GOOGLE_MAPS_API_KEY=

# ===== Seed =====
SEED_ADMIN_EMAIL=admin@bookly.app
SEED_ADMIN_PASSWORD=Admin@12345
