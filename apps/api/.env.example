# ===== قاعدة البيانات (Postgres) =====
POSTGRES_PORT=5433
DATABASE_URL=postgresql://bookly:bookly@localhost:5433/bookly?schema=public

# ===== التطبيق =====
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
WEB_ORIGIN=http://localhost:3000

# ===== المصادقة (غيّر الأسرار في الإنتاج) =====
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ===== تخزين الملفات (MinIO / S3) =====
# MinIO محلي: S3_ENDPOINT=http://localhost:9000
# AWS S3:    اتركه فارغاً لاستخدام AWS افتراضياً
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bookly-uploads
S3_ACCESS_KEY=bookly
S3_SECRET_KEY=bookly_secret
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000

# ===== Redis =====
REDIS_URL=redis://localhost:6379

# ===== البريد الإلكتروني (SMTP) =====
# SendGrid: SMTP_HOST=smtp.sendgrid.net | SMTP_USER=apikey | SMTP_PASS=SG.xxx
# Gmail:    SMTP_HOST=smtp.gmail.com   | SMTP_USER=you@gmail.com | SMTP_PASS=app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@bookly.app
MAIL_FROM_NAME=Bookly

# ===== رسائل SMS (Twilio) =====
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=+1234567890

# ===== Firebase FCM (الإشعارات) =====
# من Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ===== بوابات الدفع =====
# PAYMENT_MODE=sandbox يسمح بمحاكاة الدفع فقط
# PAYMENT_MODE=live يمنع الشحن والدفع الإلكتروني غير المفعّل (يدفع بالمحفظة/عند الوصول)
PAYMENT_MODE=sandbox

# زين كاش (العراق)
ZAIN_CASH_MERCHANT_ID=
ZAIN_CASH_MSISDN=
ZAIN_CASH_SECRET=

# FastPay (العراق)
FASTPAY_MERCHANT_ID=
FASTPAY_API_KEY=
FASTPAY_SECRET=

# Stripe (بطاقات دولية)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# آسيا حوالة
ASIA_HAWALA_MERCHANT_ID=

# ===== نسب العمولة =====
COMMISSION_FARM=15
COMMISSION_HOTEL=12
COMMISSION_CAR=12
COMMISSION_FLIGHT=3
COMMISSION_TRIP=10

# ===== نقاط الولاء =====
POINTS_PER_CURRENCY_UNIT=0.01
POINT_VALUE_MINOR=1
POINTS_REDEEM_RATIO=0.001

# ===== خدمات خارجية =====
GOOGLE_MAPS_API_KEY=

# ===== حساب المدير من الـ seed =====
SEED_ADMIN_EMAIL=admin@bookly.app
SEED_ADMIN_PASSWORD=Admin@12345

# ===== رسوم الخدمة (٪) =====
SERVICE_FEE_PERCENT=0
